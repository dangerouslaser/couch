 	assert(ha100_led_boot_state(4, 1) == -1);
 	assert(ha100_led_runtime_state("red", 2, 1) == HA100_CHARGE_HIGH);
 	assert(ha100_led_runtime_state("red", 2, 255) == HA100_CHARGE_HIGH);
