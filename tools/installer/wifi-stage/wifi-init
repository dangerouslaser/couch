#!/bin/busybox sh
# RAM-only network bootstrap. Never mount userdata or replay Android properties.
BB=/bin/busybox
umask 077
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
starting_supplicant=0
supplicant=
supplicant_start=
# The supplicant links OpenSSL 3, whose first RAND use calls getrandom(2) and
# blocks until this 3.18 kernel's nonblocking pool is initialized. On an idle
# board only device interrupts feed that pool, so it can take minutes after
# boot. Give it time instead of declaring a dead supplicant after ten seconds.
if [ -f /etc/couch-wifi-debug-mode ]; then
    SOCKET_WAIT=300
else
    SOCKET_WAIT=90
fi
echo initializing > /tmp/couch-wifi.status
uptime_s() {
    $BB cut -d' ' -f1 /proc/uptime 2>/dev/null
}
entropy() {
    $BB cat /proc/sys/kernel/random/entropy_avail 2>/dev/null || echo '?'
}
pool_state() {
    # Linux 3.18 logs this once, when getrandom(2) stops blocking.
    if $BB dmesg 2>/dev/null | $BB grep -q 'random: nonblocking pool is initialized'; then
        echo ready
    else
        echo seeding
    fi
}
timeline() {
    echo "[$(uptime_s)s] $1 entropy=$(entropy) pool=$(pool_state)" >> /tmp/couch-wifi-timeline.log
}
step() {
    echo "$1" > /tmp/couch-wifi.step
    echo "WiFi step: $1" >> /tmp/probe.log
    timeline "step $1"
}
random_dmesg() {
    # Kernel randomness messages carry the uptime at which the pool became
    # usable; this is the measurement the debug stage exists to take.
    $BB dmesg 2>/dev/null | $BB grep 'random:' | $BB tail -c "$1"
}
debug_startup_evidence() {
    # This path is reachable only while the empty-network supplicant is
    # starting. It prefers the timeline and liveness record over kernel
    # history, while retaining a small kernel tail.
    {
        echo "WiFi failed: $1"
        # The wait-state snapshots below are fixed, pre-credential
        # observations, not a host supplied process inspection interface.
        $BB tail -c 900 /tmp/couch-wifi-timeline.log 2>/dev/null
        $BB tail -c 1100 /tmp/couch-wifi-debug.wait 2>/dev/null
        if $BB kill -0 "$supplicant" 2>/dev/null; then
            echo "WiFi supplicant pid $supplicant still running at failure"
        else
            echo "WiFi supplicant pid $supplicant no longer running at failure, exit status ${supplicant_exit:-unknown}"
        fi
        echo "WiFi kernel randomness:"
        random_dmesg 300
        echo "WiFi control directory:"
        { $BB ls -la /tmp/couch-wpa 2>&1 || \
            echo 'WiFi control directory absent'; } | $BB head -c 200
        echo "WiFi supplicant log tail:"
        $BB tail -c 500 /tmp/couch-wpa-startup.log 2>/dev/null
        $BB dmesg | $BB grep -iE 'gen2.*(error|warn|fail)' | $BB tail -c 200
        $BB dmesg | $BB tail -c 256 2>/dev/null
    } | $BB tail -c 4096 > /tmp/couch-wifi-debug.log
}

debug_ready_evidence() {
    # Success is evidence too: how long the control socket took, and when the
    # kernel pool became usable, decide the production wait and accelerator.
    {
        echo "WiFi supplicant control socket ready after ${1}s"
        $BB tail -c 1200 /tmp/couch-wifi-timeline.log 2>/dev/null
        $BB tail -c 1400 /tmp/couch-wifi-debug.wait 2>/dev/null
        echo "WiFi kernel randomness:"
        random_dmesg 400
        echo "WiFi supplicant log tail:"
        $BB tail -c 600 /tmp/couch-wpa-startup.log 2>/dev/null
    } | $BB tail -c 4096 > /tmp/couch-wifi-debug.log
}

debug_late_watch() {
    # After a socket timeout the blocked supplicant is left alone. Keep
    # watching it for a bounded time so a late socket or a late pool
    # initialization still lands in the bounded debug log.
    pid=$1
    n=0
    while [ "$n" -lt 1500 ]; do
        if [ -S /tmp/couch-wpa/wlan0 ] || ! $BB kill -0 "$pid" 2>/dev/null; then
            break
        fi
        $BB sleep 2; n=$((n+2))
    done
    {
        if [ -S /tmp/couch-wpa/wlan0 ]; then
            echo "WiFi late: control socket appeared at $(uptime_s)s entropy=$(entropy)"
        elif $BB kill -0 "$pid" 2>/dev/null; then
            echo "WiFi late: supplicant still blocked at $(uptime_s)s entropy=$(entropy)"
        else
            echo "WiFi late: supplicant exited before $(uptime_s)s"
        fi
        random_dmesg 200
    } | $BB head -c 600 >> /tmp/couch-wifi-debug.log
}

debug_print_proc_field() {
    # The caller has already bound this PID to the child it created. Read only
    # small, textual kernel status files; never read process memory, environ,
    # or the supplicant configuration.
    label=$1
    path=$2
    limit=$3
    if [ ! -e "$path" ]; then
        echo "WiFi wait $label: unavailable"
        return
    fi
    if [ ! -r "$path" ]; then
        echo "WiFi wait $label: permission-denied"
        return
    fi
    value=$($BB head -c "$limit" "$path" 2>/dev/null | \
        $BB tr -c '\011\012\015\040-\176' '?')
    if [ -n "$value" ]; then
        printf 'WiFi wait %s: %s\n' "$label" "$value"
    else
        echo "WiFi wait $label: unavailable-or-empty"
    fi
}

debug_fd_snapshot() {
    fd_dir=/proc/$supplicant/fd
    if [ ! -d "$fd_dir" ]; then
        echo 'WiFi wait fds: unavailable'
        return
    fi
    if [ ! -r "$fd_dir" ]; then
        echo 'WiFi wait fds: permission-denied'
        return
    fi
    # Limit both enumeration and each target. Numeric entries are kernel
    # supplied, so word splitting cannot introduce a path from the host.
    entries=$($BB ls -1 "$fd_dir" 2>/dev/null | $BB head -n 17)
    count=0
    for fd in $entries; do count=$((count + 1)); done
    if [ "$count" -gt 16 ]; then
        echo 'WiFi wait fd-count: 16+'
        entries=$($BB printf '%s\n' "$entries" | $BB head -n 16)
    else
        echo "WiFi wait fd-count: $count"
    fi
    for fd in $entries; do
        case "$fd" in *[!0-9]*|'') continue;; esac
        target=$($BB readlink "$fd_dir/$fd" 2>/dev/null | \
            $BB head -c 96 | $BB tr -c '\011\012\015\040-\176' '?')
        [ -n "$target" ] || target=unavailable
        printf 'WiFi wait fd-%s: %s\n' "$fd" "$target"
    done
}

debug_wait_snapshot() {
    checkpoint=$1
    [ -f /etc/couch-wifi-debug-mode ] || return 0
    {
        echo "WiFi wait snapshot: ${checkpoint}s uptime=$(uptime_s)s entropy=$(entropy) pool=$(pool_state)"
        current_start=$($BB awk '{print $22}' "/proc/$supplicant/stat" 2>/dev/null)
        case "$supplicant_start:$current_start" in
            *[!0-9:]*|:*)
                echo 'WiFi wait identity: unavailable'
                exit 0
                ;;
        esac
        if [ "$current_start" != "$supplicant_start" ]; then
            echo 'WiFi wait identity: starttime-mismatch'
            exit 0
        fi
        command=$($BB head -c 192 "/proc/$supplicant/cmdline" 2>/dev/null | \
            $BB tr '\000' ' ' | $BB tr -c '\011\012\015\040-\176' '?')
        case "$command" in
            /sbin/wpa_supplicant\ *)
                printf 'WiFi wait identity: pid=%s starttime=%s\n' \
                    "$supplicant" "$current_start"
                ;;
            *)
                echo 'WiFi wait identity: command-mismatch'
                exit 0
                ;;
        esac
        debug_print_proc_field wchan "/proc/$supplicant/wchan" 128
        if [ "$checkpoint" = 2 ]; then
            # Full detail once; later checkpoints stay one short record each.
            debug_print_proc_field syscall "/proc/$supplicant/syscall" 192
            debug_print_proc_field stack "/proc/$supplicant/stack" 256
            debug_fd_snapshot
            if [ ! -r /proc/net/unix ]; then
                echo 'WiFi wait unix: unavailable-or-permission-denied'
            else
                unix=$($BB grep -F /tmp/couch-wpa /proc/net/unix 2>/dev/null | \
                    $BB head -c 192 | $BB tr -c '\011\012\015\040-\176' '?')
                [ -n "$unix" ] || unix=none
                printf 'WiFi wait unix: %s\n' "$unix"
            fi
        fi
    } | $BB head -c 640 >> /tmp/couch-wifi-debug.wait
}

start_supplicant() {
    # exec keeps $! bound to wpa_supplicant itself rather than a wrapper shell,
    # so liveness checks, /proc snapshots and the failure kill address the
    # real process. The debug image has no provisioning opcode or networks, so
    # detailed nl80211/control-interface output stays strictly pre-credential.
    if [ -f /etc/couch-wifi-debug-mode ]; then
        exec /sbin/wpa_supplicant -dd -i wlan0 -Dnl80211 -c /tmp/couch-wpa_supplicant.conf
    else
        exec /sbin/wpa_supplicant -i wlan0 -Dnl80211 -c /tmp/couch-wpa_supplicant.conf
    fi
}

fail() {
    echo "$1" > /tmp/couch-wifi.error
    echo failed > /tmp/couch-wifi.status
    echo "WiFi failed: $1" >> /tmp/probe.log
    timeline "failed $1"
    if [ "$starting_supplicant" = 1 ]; then
        # Only startup output from the empty-network configuration is exposed.
        # Once ready, provisioning may include secrets and logs stay RAM-private.
        $BB tail -c 4096 /tmp/couch-wpa-startup.log >> /tmp/probe.log 2>/dev/null
        # A live supplicant with no control socket and a dead one are different
        # faults. Record which happened, plus the timeline, control directory
        # and kernel tail, which init stops emitting once credentials arrive
        # and so cannot show a supplicant crash.
        $BB cat /tmp/couch-wifi-timeline.log >> /tmp/probe.log 2>/dev/null
        if $BB kill -0 "$supplicant" 2>/dev/null; then
            echo "WiFi supplicant pid $supplicant still running at failure" >> /tmp/probe.log
        else
            echo "WiFi supplicant pid $supplicant no longer running at failure, exit status ${supplicant_exit:-unknown}" >> /tmp/probe.log
        fi
        echo "WiFi control directory:" >> /tmp/probe.log
        { $BB ls -la /tmp/couch-wpa 2>&1 || \
            echo 'WiFi control directory absent'; } | $BB head -c 1024 >> /tmp/probe.log
        random_dmesg 1024 >> /tmp/probe.log
        $BB dmesg | $BB tail -c 4096 >> /tmp/probe.log 2>/dev/null
        if [ -f /etc/couch-wifi-debug-mode ]; then
            debug_startup_evidence "$1"
            if [ "$1" = supplicant-socket-timeout ]; then
                debug_late_watch "$supplicant" &
            fi
        fi
    fi
    # The debug binary has no provisioning opcode. Preserve only this bounded
    # startup record for its USB status operation, never arbitrary log files.
    if [ -f /etc/couch-wifi-debug-mode ] && [ "$starting_supplicant" != 1 ]; then
        $BB tail -c 4096 /tmp/probe.log > /tmp/couch-wifi-debug.log 2>/dev/null
    fi
    exit 1
}
step detect
for spec in ttyMT1:210 ttyMT2:211 ttyMT3:212; do
    [ -e /dev/${spec%%:*} ] || $BB mknod /dev/${spec%%:*} c 204 ${spec##*:}
done
# mdev -s would expose writable block devices. Discover only required char nodes.
node() {
    major=$($BB awk -v name="$2" '$2==name {print $1;exit}' /proc/devices)
    case "$major" in ''|*[!0-9]*) return 1;; esac
    [ -e "/dev/$1" ] || $BB mknod -m 600 "/dev/$1" c "$major" 0
}
node wmtdetect mtk_wcn_detect || fail detect-node
for firmware in /vendor/firmware/*; do
    [ ! -f "$firmware" ] || $BB ln -s "$firmware" / 2>/dev/null
done
step loader
LD_LIBRARY_PATH=/system/lib:/vendor/lib /vendor/bin/wmt_loader >/tmp/wmt-loader.log 2>&1
loader_rc=$?
echo "WiFi loader exit: $loader_rc" >> /tmp/probe.log
# The pinned Android loader returns its final property_set() result, even
# after successful hardware detection. This RAM stage deliberately has no
# Android property service. Require the driver's post-detection registration
# instead; a missing transport still stops startup before any credentials.
if [ "$loader_rc" -ne 0 ]; then
    $BB awk '$2=="mtk_stp_wmt" {found=1} END {exit !found}' /proc/devices || fail loader-exit
    echo 'WiFi loader: transport registered despite Android exit status' >> /tmp/probe.log
fi
node stpwmt mtk_stp_wmt || fail transport-node
node wmtWifi mtk_wmt_WIFI_chrdev || fail wifi-node
step transport
# Only this process receives the bridge; the loader must detect hardware first.
wmt_preload=
[ ! -f /lib/couch-wmt-properties.so ] || wmt_preload=/lib/couch-wmt-properties.so
LD_PRELOAD="$wmt_preload" \
LD_LIBRARY_PATH=/system/lib:/vendor/lib:/system/lib/hw:/vendor/lib/hw \
    /vendor/bin/wmt_launcher -p /vendor/firmware/ >/tmp/wmt-launcher.log 2>&1 &
launcher=$!
n=0
while ! $BB dmesg | $BB grep -qE 'set STP mode success|wmt_lib_set_hif:new hifType'; do
    $BB kill -0 "$launcher" 2>/dev/null || fail launcher-exit
    [ "$n" -lt 20 ] || fail transport-timeout
    $BB sleep 1; n=$((n+1))
done
# Use driver default calibration behavior. No fabricated/persisted device identity.
step power
if [ -f /etc/couch-wifi-debug-mode ]; then
    # The gen2 driver logs through pr_debug; open its tap so a failed probe or
    # a stalled ioctl says something in the bounded kernel tail.
    $BB mount -t debugfs none /sys/kernel/debug 2>/dev/null
    echo 'file *gen2* +p' > /sys/kernel/debug/dynamic_debug/control 2>/dev/null
fi
echo 1 > /dev/wmtWifi || fail power-on
n=0
while [ ! -d /sys/class/net/wlan0 ]; do
    [ "$n" -lt 15 ] || fail interface-timeout
    $BB sleep 1; n=$((n+1))
done
timeline "wlan0 registered after ${n}s"
# The proven runtime path settles for three seconds after the interface
# registers before bringing it up.
$BB sleep 3
$BB ifconfig wlan0 up || fail interface-up
if [ -f /etc/couch-wifi-debug-mode ]; then
    echo 'file *gen2* -p' > /sys/kernel/debug/dynamic_debug/control 2>/dev/null
fi
timeline "wlan0 up"
# Start one supplicant with no networks. Scans and provisioning share its PID.
# v2.10 initializes the control interface after driver setup; make its private
# directory explicit before launch instead of relying on that later setup.
$BB mkdir -p -m 700 /tmp/couch-wpa || fail control-directory
$BB chmod 700 /tmp/couch-wpa || fail control-directory
printf 'ctrl_interface=/tmp/couch-wpa\nupdate_config=0\n' > /tmp/couch-wpa_supplicant.conf
starting_supplicant=1
if [ -f /etc/couch-wifi-debug-mode ]; then
    : > /tmp/couch-wifi-debug.wait
fi
timeline "supplicant starting"
start_supplicant >/tmp/couch-wpa-startup.log 2>&1 &
supplicant=$!
supplicant_start=$($BB awk '{print $22}' "/proc/$supplicant/stat" 2>/dev/null)
n=0
while [ ! -S /tmp/couch-wpa/wlan0 ]; do
    # These two outcomes are different faults and must not share a reason.
    if ! $BB kill -0 "$supplicant" 2>/dev/null; then
        wait "$supplicant"
        supplicant_exit=$?
        fail supplicant-exit
    fi
    case "$n" in 2|8|20|40|60|90|120|180|240) debug_wait_snapshot "$n";; esac
    [ "$n" -lt "$SOCKET_WAIT" ] || fail supplicant-socket-timeout
    $BB sleep 1; n=$((n+1))
done
starting_supplicant=0
timeline "control socket ready after ${n}s"
echo "WiFi supplicant control socket ready after ${n}s" >> /tmp/probe.log
# The dedicated debug stage never reaches provisioning or DHCP. It leaves the
# empty-network supplicant alive for observation until its fixed supervisor
# receives a retry marker; no credential-bearing configuration can be accepted.
if [ -f /etc/couch-wifi-debug-mode ]; then
    debug_ready_evidence "$n"
    echo ready > /tmp/couch-wifi.status
    while $BB kill -0 "$supplicant" 2>/dev/null; do $BB sleep 1; done
    wait "$supplicant"
    supplicant_exit=$?
    starting_supplicant=1
    fail supplicant-exit
fi
step credentials
echo ready > /tmp/couch-wifi.status
while true; do
    $BB kill -0 "$supplicant" 2>/dev/null || fail supplicant-exit
    if [ -f /tmp/couch-wifi.request ] && [ -f /tmp/couch-wpa_supplicant.conf ]; then
        $BB rm -f /tmp/couch-wifi.request /tmp/couch-wifi.ip
        # From here the configuration may carry a network key; init stops
        # streaming startup logs over the diagnostic serial channel.
        : > /tmp/couch-wifi.credentials
        echo connecting > /tmp/couch-wifi.status
        step connect
        # The USB worker already reconfigured this supplicant and received OK.
        $BB udhcpc -i wlan0 -f -n -t 20 -T 3 -s /bin/couch-dhcp \
            >/dev/null 2>&1 &
        dhcp=$!
        while $BB kill -0 "$supplicant" 2>/dev/null && $BB kill -0 "$dhcp" 2>/dev/null; do
            $BB sleep 2
        done
        if $BB kill -0 "$supplicant" 2>/dev/null; then
            reason=dhcp-exit
        else
            reason=supplicant-exit
        fi
        $BB kill "$supplicant" "$dhcp" 2>/dev/null
        $BB rm -f /tmp/couch-wifi.ip
        fail "$reason"
    fi
    $BB sleep 1
done
