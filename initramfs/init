#!/bin/busybox sh
# Sanytron HA100 (MT6580) - Linux with an Alpine userland.
#
# This kernel has no CONFIG_VT, so there is no console and a working boot looks
# exactly like a hung one. /extra/fbcon draws our stdout to the framebuffer,
# which is why the body runs inside main() piped into it.
#
# The real userland is Alpine armv7 on the cache partition, installed from
# Android over adb. We stay PID 1 and chroot into it, rather than switch_root
# into OpenRC, because this kernel has no devtmpfs for OpenRC to rely on.
#
# WiFi is parked: MediaTek's wmt_loader chain leaves the driver in a state where
# writing /dev/wmtWifi panics the kernel inside wmt_drv. Set WIFI=1 below to
# retry it; it is guarded and will refuse rather than panic.

BB=/bin/busybox
LOG=/dev/mmcblk0p9
BASE=24576
AUSB=/sys/class/android_usb/android0
ALPINE=/mnt/alpine
WIFI=0

mark() { $BB echo "$2" | $BB dd of=$LOG bs=512 seek=$1 count=1 conv=notrunc 2>/dev/null; }

main() {
    trap '' PIPE

    $BB mount -t proc proc /proc
    $BB mount -t sysfs sysfs /sys
    $BB mount -t tmpfs tmpfs /tmp
    $BB --install -s /bin
    export PATH=/bin:/sbin:/usr/bin:/usr/sbin
    mark $((BASE+1)) "S1 mounts"

    # Whatever happens below, the next reboot goes back to Android.
    $BB dd if=/dev/zero of=/dev/mmcblk0p10 bs=512 count=1 conv=notrunc 2>/dev/null
    echo "= BCB cleared: next reboot returns to Android"

    for c in 1 2 3; do $BB echo 1 > /sys/devices/system/cpu/cpu$c/online 2>/dev/null; done
    echo "= cpus $($BB nproc)  mem $($BB free | $BB awk '/Mem:/{print int($4/1024)}')MB free"
    mark $((BASE+2)) "S2 cpus=$($BB nproc)"

    ( $BB sleep 600; [ -f /tmp/stay ] || $BB reboot -f ) &

    # --- Alpine rootfs ----------------------------------------------------------
    $BB mkdir -p $ALPINE
    if $BB mount -t ext4 /dev/mmcblk0p22 $ALPINE 2>/dev/null && [ -f $ALPINE/etc/alpine-release ]; then
        HAVE_ALPINE=yes
        $BB mkdir -p $ALPINE/proc $ALPINE/sys $ALPINE/dev $ALPINE/tmp
        $BB mount -t proc proc $ALPINE/proc 2>/dev/null
        $BB mount -t sysfs sysfs $ALPINE/sys 2>/dev/null
        $BB mount -o bind /dev $ALPINE/dev 2>/dev/null
        $BB mount -t tmpfs tmpfs $ALPINE/tmp 2>/dev/null
        echo "= alpine $($BB cat $ALPINE/etc/alpine-release) mounted on $ALPINE"
    else
        HAVE_ALPINE=no
        echo "= alpine FAIL: no rootfs on the cache partition"
    fi
    mark $((BASE+3)) "S3 alpine=$HAVE_ALPINE"

    # --- USB serial shell, inside Alpine when we have it ------------------------
    $BB echo 1 > /sys/devices/platform/mt_usb/cmode 2>/dev/null
    $BB echo 0 > $AUSB/enable 2>/dev/null
    $BB echo 1 > $AUSB/f_acm/instances 2>/dev/null   # 0 by default = no endpoints
    $BB echo 0e8d > $AUSB/idVendor 2>/dev/null
    $BB echo 201c > $AUSB/idProduct 2>/dev/null
    $BB echo acm > $AUSB/functions 2>/dev/null
    $BB echo 1 > $AUSB/enable 2>/dev/null
    if [ "$HAVE_ALPINE" = yes ]; then
        ( while true; do
            $BB chroot $ALPINE /bin/sh -l </dev/ttyGS0 >/dev/ttyGS0 2>&1
            $BB sleep 1
          done ) &
        echo "= shell: alpine /bin/sh on usb serial"
    else
        ( while true; do $BB sh </dev/ttyGS0 >/dev/ttyGS0 2>&1; $BB sleep 1; done ) &
        echo "= shell: busybox on usb serial (fallback)"
    fi

    # --- Android partitions, for the vendor blobs and firmware -------------------
    $BB mkdir -p /system /vendor /dev/__properties__
    $BB mount -t ext4 -o ro /dev/mmcblk0p21 /system 2>/dev/null
    $BB mount -t ext4 -o ro /dev/mmcblk0p14 /vendor 2>/dev/null
    $BB mount -t tmpfs tmpfs /dev/__properties__ 2>/dev/null
    ( cd /dev/__properties__ && $BB tar xzf /extra/props.tar.gz 2>/dev/null )
    echo "= /system $([ -x /system/bin/linker ] && echo ok || echo FAIL)  /vendor $([ -d /vendor/lib/modules ] && echo ok || echo FAIL)  props $($BB ls /dev/__properties__ | $BB wc -l)"

    # --- WiFi (parked; set WIFI=1 to retry) --------------------------------------
    if [ "$WIFI" = "1" ]; then
        $BB insmod /vendor/lib/modules/wmt_drv.ko 2>/dev/null
        n=0; while [ $n -lt 15 ]; do $BB mdev -s; [ -e /dev/stpwmt ] && break; $BB sleep 1; n=$((n+1)); done
        echo "= stpwmt $([ -e /dev/stpwmt ] && echo "ok after ${n}s" || echo MISSING)"
        LD_LIBRARY_PATH=/system/lib:/vendor/lib /vendor/bin/wmt_loader >/tmp/wmt.log 2>&1
        RC=$?
        $BB insmod /vendor/lib/modules/wmt_chrdev_wifi.ko 2>/dev/null
        $BB insmod /vendor/lib/modules/wlan_drv.ko 2>/dev/null
        $BB mdev -s
        LD_LIBRARY_PATH=/system/lib:/vendor/lib /vendor/bin/wmt_launcher -p /vendor/firmware/ >/dev/null 2>&1 &
        $BB sleep 8
        $BB dmesg | $BB dd of=$LOG bs=512 seek=28672 conv=notrunc 2>/dev/null
        OK=yes
        $BB dmesg | $BB grep -q "pwr_on fail"      && OK=no
        $BB dmesg | $BB grep -q "p_ic_ops is NULL" && OK=no
        [ "$RC" = 0 ] || OK=no
        echo "= wmt loader rc=$RC chip_ready=$OK"
        [ "$OK" = yes ] && $BB echo 1 > /dev/wmtWifi 2>/dev/null
        $BB sleep 3; $BB mdev -s
        echo "= net: $($BB ls /sys/class/net/ | $BB tr '\n' ' ')"
    else
        echo "= wifi parked (WIFI=0)"
    fi

    $BB dmesg | $BB dd of=$LOG bs=512 seek=26624 conv=notrunc 2>/dev/null
    mark $((BASE+4)) "S4 ready"
    echo ""
    echo "= READY  uptime $($BB cut -d. -f1 /proc/uptime)s  -- usb serial shell is live"
    while true; do $BB sleep 3600; done
}

$BB echo 255 > /sys/class/leds/lcd-backlight/brightness
$BB echo 255 > /sys/class/leds/button-backlight/brightness
mark $((BASE+0)) "S0 init entered"
main 2>&1 | /extra/fbcon /dev/fb0
while true; do $BB sleep 3600; done
