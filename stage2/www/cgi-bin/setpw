#!/bin/sh
# Set a root password for SSH.
#
# Same gate as key enrolment, for the same reason: the setup AP is open, so the
# request alone proves nothing about who is asking. The button press on the
# remote is the only thing standing between this and permanent root, and it must
# never become optional.
echo "Content-Type: text/plain"
echo "Cache-Control: no-store"
echo

[ "$REQUEST_METHOD" = POST ] || { echo "ERR method"; exit 0; }
BODY=$(head -c "${CONTENT_LENGTH:-0}")
PW=$(echo "$BODY" | tr '&' '\n' | grep '^pw=' | head -1 | cut -d= -f2- \
     | sed 's/+/ /g; s/%\(..\)/\\x\1/g' | xargs -0 printf '%b' 2>/dev/null)

[ -n "$PW" ] || { echo "ERR enter a password"; exit 0; }
[ ${#PW} -ge 8 ] || { echo "ERR use at least 8 characters"; exit 0; }
# chpasswd reads colon-separated lines, and a stray control character would
# corrupt /etc/shadow rather than fail loudly.
case "$PW" in
    *:*)        echo "ERR a colon is not allowed in the password"; exit 0 ;;
    *[!\ -~]*)  echo "ERR use printable ASCII only"; exit 0 ;;
esac

: > /tmp/press.request          # confirm.sh watches this
n=0
while [ $n -lt 30 ]; do
    [ -f /tmp/press.ok ] && break
    sleep 1; n=$((n + 1))
done
if [ ! -f /tmp/press.ok ]; then
    rm -f /tmp/press.request
    echo "ERR no button press on the remote - password not set"
    exit 0
fi
rm -f /tmp/press.ok /tmp/press.request

printf 'root:%s\n' "$PW" | chpasswd >/dev/null 2>&1 ||
    { echo "ERR could not set the password"; exit 0; }

# The image ships key-only, so a password alone would still be refused. Flip it
# in our own drop-in rather than in sshd_config: "Include sshd_config.d/*.conf"
# sits near the top of the main file and OpenSSH keeps the FIRST value it
# obtains for a keyword, so the drop-in beats anything written further down.
# Editing sshd_config instead looks like it works - the file plainly says yes -
# while "sshd -T" still reports no.
CONF=/etc/ssh/sshd_config.d/couch.conf
cat > "$CONF" <<'SSHD'
# Rewritten by the setup portal when a root password was set.
PermitRootLogin yes
PasswordAuthentication yes
PubkeyAuthentication yes
UseDNS no
SSHD
chmod 644 "$CONF"

# Pick up the config change if sshd is already up. Wait for the old process to
# actually go: sshd.sh bails out when it sees a running sshd, so restarting it
# too eagerly leaves the stale daemon - and its old config - in place, which
# looks exactly like the password not working.
killall sshd 2>/dev/null
n=0
while pidof sshd >/dev/null 2>&1 && [ $n -lt 10 ]; do sleep 1; n=$((n + 1)); done
sh /opt/couch/sshd.sh >/dev/null 2>&1

echo "OK Password set. SSH as root once the remote is on your network."
