// Placeholder layout. The visual design is being mocked up separately; what
// matters here is the property surface the Rust side drives, so that porting a
// mockup is a layout exercise and not a re-wiring one.
export component App inherits Window {
    width: 480px;
    height: 800px;
    background: #09090b;

    // --- status, driven from src/system.rs -----------------------------------
    in-out property <string> clock: "--:--";
    in-out property <string> battery: "";
    in-out property <bool> charging: false;

    // --- navigation ----------------------------------------------------------
    in-out property <int> sel: 0;
    in-out property <int> item-count: 6;

    // --- setup mode ----------------------------------------------------------
    in-out property <bool> setup-mode: false;
    in-out property <string> ssid: "Couch-Setup";
    in-out property <string> portal-url: "http://192.168.4.1";
    in-out property <image> qr;
    // 0 idle, 1 waiting for a button press, 2 granted, 3 timed out
    in-out property <int> approval: 0;

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow)   { root.sel = max(0, root.sel - 1); return accept; }
            if (e.text == Key.DownArrow) { root.sel = min(root.item-count - 1, root.sel + 1); return accept; }
            return reject;
        }
    }
    init => { fs.focus(); }

    if !root.setup-mode: Rectangle {
        Text {
            x: 16px; y: 16px;
            text: "Couch";
            font-size: 28px;
            color: #fafafa;
        }
        Text {
            x: 280px; y: 24px; width: 184px;
            horizontal-alignment: right;
            text: (root.charging ? "+ " : "") + root.battery + "   " + root.clock;
            font-size: 20px;
            color: #a1a1aa;
        }
        Text {
            x: 16px; y: 100px; width: 448px;
            wrap: word-wrap;
            text: "Platform layer up. Awaiting the design.\n\nselection " + root.sel;
            font-size: 16px;
            color: #a1a1aa;
        }
    }

    if root.setup-mode: Rectangle {
        Text {
            x: 0px; y: 28px; width: 480px;
            horizontal-alignment: center;
            text: "Wi-Fi Setup";
            font-size: 28px;
            color: #fafafa;
        }
        Text {
            x: 0px; y: 68px; width: 480px;
            horizontal-alignment: center;
            text: "Scan with your phone camera";
            font-size: 14px;
            color: #a1a1aa;
        }
        Rectangle {
            x: 80px; y: 108px; width: 320px; height: 320px;
            background: #ffffff;
            border-radius: 12px;
            Image {
                source: root.qr;
                width: 288px; height: 288px;
                x: 16px; y: 16px;
                image-rendering: pixelated;
            }
        }
        Text {
            x: 0px; y: 452px; width: 480px;
            horizontal-alignment: center;
            text: "Network - no password";
            font-size: 14px;
            color: #a1a1aa;
        }
        Text {
            x: 0px; y: 478px; width: 480px;
            horizontal-alignment: center;
            text: root.ssid;
            font-size: 28px;
            color: #fafafa;
        }
        Text {
            x: 0px; y: 540px; width: 480px;
            horizontal-alignment: center;
            text: "Then open  " + root.portal-url;
            font-size: 16px;
            color: #a1a1aa;
        }
        if root.approval != 0: Rectangle {
            x: 24px; y: 660px; width: 432px; height: 116px;
            background: #fafafa;
            border-radius: 12px;
            Text {
                width: parent.width;
                y: (parent.height - self.height) / 2;
                horizontal-alignment: center;
                font-size: 20px;
                color: #18181b;
                text: root.approval == 1 ? "Press any button\nto approve SSH access"
                    : root.approval == 2 ? "SSH access approved"
                    : "Approval timed out";
            }
        }
    }
}
