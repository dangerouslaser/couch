import { Theme } from "theme.slint";
import { StatusBar } from "components/status_bar.slint";
import { VolumeOverlay } from "components/volume_overlay.slint";
import { PairOverlay } from "components/pair_overlay.slint";
import { MicOverlay } from "components/mic_overlay.slint";
import { Chooser, ChoiceItem } from "components/chooser.slint";
import { HomeHub, LiveActivity, RoomRow, SceneCell } from "screens/home_hub.slint";
import { Setup } from "screens/setup.slint";
import { Keyboard } from "components/keyboard.slint";
import { Settings } from "components/settings.slint";

export { LiveActivity, RoomRow, SceneCell }

export component App inherits Window {
    width: 480px;
    height: 800px;
    background: Theme.bg;

    // --- shell ----------------------------------------------------------------
    in-out property <string> clock: "--:--";
    in-out property <int> battery: 0;
    in-out property <bool> charging: false;
    in-out property <int> wifi-level: 0;

    // --- hub data -------------------------------------------------------------
    in-out property <[LiveActivity]> activities;
    in-out property <[RoomRow]> rooms;
    in-out property <[SceneCell]> scenes;
    in-out property <string> area-name: "HOME";
    in-out property <int> area-index: 0;
    in-out property <[bool]> area-dots;
    callback area-step(int);

    // A page change is not animated here. The host keeps the frame on the
    // panel, applies the change as an instant state change with this set,
    // renders that once, and slides the old frame out and the new one in by
    // copying - a memcpy a frame where re-rasterising two pages was up to
    // 29ms (src/panel.rs). Then it clears this and the ring fades in.
    in-out property <bool> ring-hidden: false;
    /// The rows above the page, which a transition holds still.
    out property <length> status-h: 56px;
    /// The pager's band in window space, held still through an area change:
    /// it is the control, and should not travel with the thing it controls.
    out property <length> dots-y: root.status-h + hub.dots-y;
    out property <length> dots-h: hub.dots-h;

    // --- interaction ----------------------------------------------------------
    // A single top-level FocusScope driving an integer index, rather than Slint's
    // per-element focus: the hardware D-pad delivers key codes globally, and the
    // ring is explicitly authored in reading order rather than derived from
    // geometry. It also makes "restore focus per screen" a matter of keeping an
    // integer, which is what returning from a room view needs.
    //
    // The ring is one flat list of stops - the activity strip, each room, the
    // scenes row - so up and down are the only keys that move focus, and left
    // and right mean the same thing everywhere: change area. What a row index
    // means is the hub's business (see AreaPane); the host is told what was
    // opened, never which row.
    in-out property <int> focus-row: 0;
    callback open-strip();
    callback open-room(int);
    callback open-scenes();
    callback back();
    callback home();

    /// OK on whatever has focus. Also what COUCH_OPEN presses.
    public function activate() { hub.activate(); }
    /// The host parked focus somewhere (COUCH_FOCUS, COUCH_NAV): scroll to
    /// match and glide the ring there, as a key press would.
    public function settle-focus() { hub.follow-focus(); }
    /// The host has replaced the page's models: focus its first room and land
    /// the ring there, nothing travelling.
    public function page-swapped() {
        root.focus-row = hub.first-room-row;
        hub.land();
    }
    // The hub's row count, for COUCH_NAV to walk the ring with.
    out property <int> row-count: hub.row-count;

    function move(delta: int) {
        if (hub.row-count <= 0) { return; }
        root.focus-row = Math.mod(root.focus-row + delta + hub.row-count, hub.row-count);
        hub.follow-focus();
    }

    // --- first-run setup ------------------------------------------------------
    in-out property <bool> setup-mode: false;
    in-out property <string> ssid: "Couch-Setup";
    in-out property <string> portal-url: "http://192.168.4.1";
    in-out property <image> qr;
    in-out property <int> approval: 0;

    // --- chooser --------------------------------------------------------------
    // Opened by OK on the activity strip or the scenes row. While it is up it
    // owns up, down, OK and back; nothing else on the hub moves.
    in-out property <bool> chooser-shown: false;
    in-out property <string> chooser-title;
    in-out property <[ChoiceItem]> chooser-items;
    in-out property <int> chooser-index: 0;
    callback chosen(int);
    /// Escape, or Left and Right, inside the list. A callback rather than a
    /// write to chooser-shown: closing is a page transition, and that is the
    /// host's to perform once this key's dispatch has returned.
    callback close-chooser();

    // --- keyboard -------------------------------------------------------------
    // The on-screen keyboard, over the hub. Instantiated only while shown: it
    // takes focus on creation, and the shell's FocusScope takes it back when
    // the keyboard leaves. Nothing on the hub opens it yet; COUCH_KEYBOARD
    // opens it at startup so it can be tried on the panel.
    in-out property <bool> keyboard-shown: false;
    in-out property <string> keyboard-title: "ENTER TEXT";
    in-out property <string> keyboard-placeholder: "";
    in-out property <bool> keyboard-password: false;
    callback keyboard-accepted(string);
    callback keyboard-cancelled();
    public function open-keyboard() { root.keyboard-shown = true; }

    // --- settings -------------------------------------------------------------
    // Opened by a hold of the menu key on the home screen (the host times the
    // hold). A modal page over the hub, owning the D-pad while up.
    in-out property <bool> settings-shown: false;
    in-out property <int> setting-brightness: 100;
    in-out property <[string]> dim-choices;
    in-out property <int> dim-index: 0;
    in-out property <[string]> off-choices;
    in-out property <int> off-index: 0;
    in-out property <string> wifi-ssid: "";
    in-out property <bool> ssh-on: false;
    in-out property <bool> ssh-available: false;
    // A brief message, e.g. Wi-Fi progress. Non-empty shows it; the host clears it.
    in-out property <string> toast: "";
    callback setting-brightness-changed(int);
    callback setting-dim-changed(int);
    callback setting-off-changed(int);
    callback setting-change-wifi();
    callback setting-toggle-ssh();
    callback settings-closed();
    public function open-settings() { root.settings-shown = true; }

    function chooser-move(delta: int) {
        if (root.chooser-items.length <= 0) { return; }
        root.chooser-index = Math.mod(root.chooser-index + delta + root.chooser-items.length,
                                      root.chooser-items.length);
    }

    // --- microphone -----------------------------------------------------------
    // The microphone is open. Driven by whether the capture thread is alive,
    // never by a flag - see src/mic.rs.
    in-out property <bool> recording: false;
    in-out property <float> mic-level: 0;
    in-out property <bool> mic-latched: false;

    // --- pairing --------------------------------------------------------------
    // A browser is asking to pair; the digits live only here and on that
    // browser's screen.
    in-out property <bool> pair-shown: false;
    in-out property <string> pair-pin: "";
    in-out property <int> pair-seconds: 0;

    // --- volume overlay -------------------------------------------------------
    in-out property <bool> volume-shown: false;
    in-out property <int> volume: 0;
    in-out property <string> volume-target: "";

    fs := FocusScope {
        key-pressed(e) => {
            if (root.chooser-shown) {
                if (e.text == Key.UpArrow)   { root.chooser-move(-1); return accept; }
                if (e.text == Key.DownArrow) { root.chooser-move(1);  return accept; }
                if (e.text == Key.Return) { root.chosen(root.chooser-index); return accept; }
                if (e.text == Key.Escape) { root.close-chooser(); return accept; }
                // Left and right change area everywhere else; inside a list
                // they would have nothing to do, so they close it.
                if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                    root.close-chooser();
                    return accept;
                }
                return accept;
            }
            if (e.text == Key.UpArrow)    { root.move(-1); return accept; }
            if (e.text == Key.DownArrow)  { root.move(1);  return accept; }
            if (e.text == Key.LeftArrow)  { root.area-step(-1); return accept; }
            if (e.text == Key.RightArrow) { root.area-step(1);  return accept; }
            if (e.text == Key.Return)  { root.activate(); return accept; }
            if (e.text == Key.Escape)  { root.back(); return accept; }
            if (e.text == Key.Home)    { root.home(); return accept; }
            return reject;
        }
    }
    init => { fs.focus(); }

    if root.setup-mode: Setup {
        width: parent.width;
        height: parent.height;
        ssid: root.ssid;
        portal-url: root.portal-url;
        qr: root.qr;
        approval: root.approval;
    }

    if !root.setup-mode: StatusBar {
        y: 0;
        width: parent.width;
        clock: root.clock;
        title: root.settings-shown ? "SETTINGS"
             : root.keyboard-shown ? root.keyboard-title
             : root.chooser-shown ? root.chooser-title : root.area-name;
        battery: root.battery;
        charging: root.charging;
        wifi-level: root.wifi-level;
    }

    // The hub and whatever it opens, side by side on a strip. The chooser was
    // an overlay first; a sheet over a dimmed hub looked out of place in a UI
    // where everything else is a page, and a translucent scrim costs a
    // composite of the whole panel every frame where an opaque page is a
    // fill. Same motion as changing area, same duration, same layout.
    //
    // The strip jumps rather than animates: the slide between the frame
    // before the jump and the frame after it is composed by the host, see
    // ring-hidden above.
    Rectangle {
        visible: !root.setup-mode;
        y: root.status-h;
        width: parent.width;
        height: parent.height - root.status-h;
        clip: true;

        Rectangle {
            x: root.chooser-shown ? -root.width : 0px;
            width: root.width * 2;
            height: parent.height;

            hub := HomeHub {
                // Sized from the window, not from the parent: the parent is
                // the two-page strip and is twice as wide, and the viewport
                // above has already taken the status bar off the height.
                x: 0px;
                y: 0px;
                width: root.width;
                height: parent.height;
                activities: root.activities;
                rooms: root.rooms;
                scenes: root.scenes;
                area-index: root.area-index;
                area-dots: root.area-dots;
                focus-row: root.focus-row;
                ring-hidden: root.ring-hidden;
                pick(r) => {
                    root.focus-row = r;
                    hub.follow-focus();
                }
                open-strip => { root.open-strip(); }
                open-room(i) => { root.open-room(i); }
                open-scenes => { root.open-scenes(); }
            }

            Chooser {
                x: root.width;
                y: 0px;
                width: root.width;
                height: parent.height;
                shown: root.chooser-shown;
                title: root.chooser-title;
                items: root.chooser-items;
                index: root.chooser-index;
                // A tap on a row selects it and acts on it, the rule the
                // strip and the scenes card follow.
                pick(i) => { root.chooser-index = i; }
                choose(i) => { root.chosen(i); }
            }
        }
    }


    if root.keyboard-shown: Keyboard {
        x: 0px;
        y: root.status-h;
        width: root.width;
        height: root.height - root.status-h;
        title: root.keyboard-title;
        placeholder: root.keyboard-placeholder;
        password: root.keyboard-password;
        accepted(t) => { root.keyboard-shown = false; fs.focus(); root.keyboard-accepted(t); }
        cancelled => { root.keyboard-shown = false; fs.focus(); root.keyboard-cancelled(); }
    }

    if root.settings-shown: Settings {
        x: 0px;
        y: root.status-h;
        width: root.width;
        height: root.height - root.status-h;
        shown: root.settings-shown;
        brightness: root.setting-brightness;
        dim-choices: root.dim-choices;
        dim-index: root.dim-index;
        off-choices: root.off-choices;
        off-index: root.off-index;
        wifi-ssid: root.wifi-ssid;
        wifi-level: root.wifi-level;
        ssh-on: root.ssh-on;
        ssh-available: root.ssh-available;
        brightness-changed(v) => { root.setting-brightness = v; root.setting-brightness-changed(v); }
        dim-changed(i) => { root.dim-index = i; root.setting-dim-changed(i); }
        off-changed(i) => { root.off-index = i; root.setting-off-changed(i); }
        change-wifi => { root.setting-change-wifi(); }
        toggle-ssh => { root.setting-toggle-ssh(); }
        closed => { root.settings-shown = false; fs.focus(); root.settings-closed(); }
    }

    MicOverlay {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        shown: root.recording;
        level: root.mic-level;
        latched: root.mic-latched;
    }

    PairOverlay {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        shown: root.pair-shown;
        pin: root.pair-pin;
        seconds-left: root.pair-seconds;
    }

    // A transient message near the bottom, above everything. The host sets the
    // text and clears it on a timer.
    if root.toast != "": Rectangle {
        x: 24px;
        width: parent.width - 48px;
        height: 56px;
        y: parent.height - self.height - 40px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-raised;
        border-radius: Theme.r-overlay;
        Text {
            width: parent.width - 32px;
            x: 16px;
            y: (parent.height - self.height) / 2;
            text: root.toast;
            font-size: 19px;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    VolumeOverlay {
        x: 36px;
        width: parent.width - 72px;
        y: parent.height - self.height - 36px;
        target: root.volume-target;
        value: root.volume;
        shown: root.volume-shown;
    }
}
