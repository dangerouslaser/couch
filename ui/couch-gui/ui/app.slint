import { Theme } from "theme.slint";
import { StatusBar } from "components/status_bar.slint";
import { VolumeOverlay } from "components/volume_overlay.slint";
import { PairOverlay } from "components/pair_overlay.slint";
import { MicOverlay } from "components/mic_overlay.slint";
import { Chooser, ChoiceItem } from "components/chooser.slint";
import { HomeHub, LiveActivity, RoomRow, SceneCell } from "screens/home_hub.slint";
import { Setup } from "screens/setup.slint";

export { LiveActivity, RoomRow, SceneCell }

export component App inherits Window {
    width: 480px;
    height: 800px;
    background: Theme.bg;

    // --- shell ----------------------------------------------------------------
    in-out property <string> clock: "--:--";
    in-out property <string> context-title: "HOME";
    in-out property <int> battery: 0;
    in-out property <bool> charging: false;

    // --- hub data -------------------------------------------------------------
    in-out property <[LiveActivity]> activities;
    in-out property <[RoomRow]> rooms;
    // The incoming page during a transition; the host fills it, then asks for
    // the slide, then adopts it when the hub reports settled.
    in-out property <[RoomRow]> rooms-next;
    in-out property <[LiveActivity]> activities-next;
    in-out property <[SceneCell]> scenes-next;
    callback settled();
    public function slide(dir: int) { hub.slide(dir); }
    in-out property <string> area-name: "HOME";
    in-out property <int> area-index: 0;
    in-out property <int> area-count: 1;
    in-out property <[bool]> area-dots;
    callback area-step(int);
    in-out property <[SceneCell]> scenes;

    // --- interaction ----------------------------------------------------------
    // A single top-level FocusScope driving an integer index, rather than Slint's
    // per-element focus: the hardware D-pad delivers key codes globally, and the
    // ring is explicitly authored in reading order rather than derived from
    // geometry. It also makes "restore focus per screen" a matter of keeping an
    // integer, which is what returning from a room view needs.
    // Focus is a row plus a column, not one flat ring. The horizontal rows -
    // activities and scenes - own the horizontal axis, so up and down step
    // between rows and left and right move within them. In the room list, which
    // has no horizontal extent, left and right change area instead.
    in-out property <int> focus-row: 0;
    callback activated(int);
    callback back();
    callback home();

    // --- first-run setup ------------------------------------------------------
    in-out property <bool> setup-mode: false;
    in-out property <string> ssid: "Couch-Setup";
    in-out property <string> portal-url: "http://192.168.4.1";
    in-out property <image> qr;
    in-out property <int> approval: 0;

    // --- volume overlay -------------------------------------------------------
    // The chooser, opened by OK on the activity strip or the scenes row. While
    // it is up it owns up, down, OK and back; nothing else on the hub moves.
    in-out property <bool> chooser-shown: false;
    in-out property <string> chooser-title;
    in-out property <[ChoiceItem]> chooser-items;
    in-out property <int> chooser-index: 0;
    callback chosen(int);

    // The microphone is open. Driven by whether the capture thread is alive,
    // never by a flag - see src/mic.rs.
    in-out property <bool> recording: false;
    in-out property <float> mic-level: 0;
    in-out property <bool> mic-latched: false;

    // A browser is asking to pair; the digits live only here and on that
    // browser's screen.
    in-out property <bool> pair-shown: false;
    in-out property <string> pair-pin: "";
    in-out property <int> pair-seconds: 0;

    in-out property <bool> volume-shown: false;
    in-out property <int> volume: 0;
    in-out property <string> volume-target: "";

    // Lets the host park focus somewhere and have the list scroll to match.
    public function settle-focus() { hub.ensure-visible(); }
    // Changing area replaces the whole list, so the old scroll position means
    // nothing: start the new area at the top.
    public function begin-swap() { hub.begin-swap(); }
    public function end-swap() { hub.end-swap(); }
    public function reset-scroll() { hub.reset-scroll(); }

    property <int> act-count: root.activities.length;
    property <int> first-room-row: root.act-count > 0 ? 1 : 0;
    property <int> scenes-row: root.first-room-row + root.rooms.length;
    property <int> row-count: root.scenes-row + 1;

    function move(delta: int) {
        if (root.row-count <= 0) { return; }
        root.focus-row = Math.mod(root.focus-row + delta + root.row-count, root.row-count);
        // A row remembers nothing: entering it always starts at its first cell,
        // which is predictable in a way that "wherever you were last" is not.
        hub.ensure-visible();
    }


    fs := FocusScope {
        key-pressed(e) => {
            if (root.chooser-shown) {
                if (e.text == Key.UpArrow) {
                    root.chooser-index = Math.mod(root.chooser-index - 1
                        + root.chooser-items.length, root.chooser-items.length);
                    return accept;
                }
                if (e.text == Key.DownArrow) {
                    root.chooser-index = Math.mod(root.chooser-index + 1,
                        root.chooser-items.length);
                    return accept;
                }
                if (e.text == Key.Return) { root.chosen(root.chooser-index); return accept; }
                if (e.text == Key.Escape) { root.chooser-shown = false; return accept; }
                // Left and right change area everywhere else; inside a list
                // they would have nothing to do, so they close it.
                if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                    root.chooser-shown = false;
                    return accept;
                }
                return accept;
            }
            if (e.text == Key.UpArrow)    { root.move(-1); return accept; }
            if (e.text == Key.DownArrow)  { root.move(1);  return accept; }
            if (e.text == Key.LeftArrow)  { root.area-step(-1); return accept; }
            if (e.text == Key.RightArrow) { root.area-step(1);  return accept; }
            if (e.text == Key.Return)  { root.activated(root.focus-row); return accept; }
            if (e.text == Key.Escape)  { root.back(); return accept; }
            if (e.text == Key.Home)    { root.home(); return accept; }
            return reject;
        }
    }
    init => { fs.focus(); }

    if root.setup-mode: Setup {
        width: parent.width;
        height: parent.height;
        ssid: root.ssid;
        portal-url: root.portal-url;
        qr: root.qr;
        approval: root.approval;
    }

    if !root.setup-mode: StatusBar {
        y: 0;
        width: parent.width;
        clock: root.clock;
        title: root.setup-mode ? root.context-title
             : root.chooser-shown ? root.chooser-title
             : root.area-name;
        battery: root.battery;
        charging: root.charging;
    }

    // The hub and whatever it opens, side by side on a strip that slides. The
    // chooser was an overlay first; a sheet over a dimmed hub looked out of
    // place in a UI where everything else is a page, and a translucent scrim
    // costs a composite of the whole panel every frame where an opaque page is
    // a fill. Same motion as changing area, same duration, same layout.
    Rectangle {
        visible: !root.setup-mode;
        y: 56px;
        width: parent.width;
        height: parent.height - 56px;
        clip: true;

        Rectangle {
            x: root.chooser-shown ? -root.width : 0px;
            width: root.width * 2;
            height: parent.height;
            animate x { duration: 190ms; easing: ease-out; }

            hub := HomeHub {
                // Sized from the window, not from the parent: the parent is
                // the two-page strip and is twice as wide, and the viewport
                // above has already taken the status bar off the height.
                x: 0px;
                y: 0px;
                width: root.width;
                height: parent.height;
            pick(r) => {
                root.focus-row = r;
                hub.ensure-visible();
            }
            // A tap on the strip or the scenes row opens it, because those two
            // exist only to be opened; a tap on a room only selects it.
            open(r) => { root.activated(r); }
            activities: root.activities;
            activities-next: root.activities-next;
            rooms: root.rooms;
            rooms-next: root.rooms-next;
            scenes-next: root.scenes-next;
            settled() => { root.settled(); }
            area-name: root.area-name;
            area-index: root.area-index;
            area-count: root.area-count;
            area-dots: root.area-dots;
            scenes: root.scenes;
            focus-row: root.focus-row;
            first-room-row: root.first-room-row;
            scenes-row: root.scenes-row;
        }

            Chooser {
                x: root.width;
                y: 0px;
                width: root.width;
                height: parent.height;
                shown: root.chooser-shown;
                title: root.chooser-title;
                items: root.chooser-items;
                index: root.chooser-index;
            }
        }
    }


    MicOverlay {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        shown: root.recording;
        level: root.mic-level;
        latched: root.mic-latched;
    }

    PairOverlay {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        shown: root.pair-shown;
        pin: root.pair-pin;
        seconds-left: root.pair-seconds;
    }

    VolumeOverlay {
        x: 36px;
        width: parent.width - 72px;
        y: parent.height - self.height - 36px;
        target: root.volume-target;
        value: root.volume;
        shown: root.volume-shown;
    }
}
