import { Theme } from "../theme.slint";
import { Chooser, ChoiceItem } from "chooser.slint";

export component WifiSetup inherits Rectangle {
    in property <bool> shown;
    in property <string> caption: "WI-FI SETUP";
    in property <string> title;
    in property <string> detail;
    in property <[ChoiceItem]> items;
    property <int> index: 0;
    in property <image> qr;
    in property <bool> has-qr: false;
    callback activate(int);
    callback back();
    changed items => { root.index = 0; }
    public function take-focus() { keys.focus(); }
    background: Theme.bg;
    VerticalLayout {
        padding-top: 26px;
        spacing: 12px;
        Text { text: root.caption; color: Theme.text-quaternary; font-size: 15px; horizontal-alignment: center; }
        Text { text: root.title; color: Theme.text; font-size: 28px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: root.detail; color: Theme.text-secondary; font-size: 18px; horizontal-alignment: center; wrap: word-wrap; min-height: 70px; }
        if root.has-qr: HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Image { source: root.qr; width: 180px; height: 180px; }
            Rectangle { horizontal-stretch: 1; }
        }
        Chooser {
            shown: root.shown;
            items: root.items;
            index: root.index;
            pick(i) => { root.index = i; }
            choose(i) => { root.activate(i); }
        }
        Text { text: "BACK · cancel / return"; color: Theme.text-tertiary; font-size: 16px; horizontal-alignment: center; height: 28px; }
    }
    keys := FocusScope {
        enabled: root.shown;
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.back(); return accept; }
            if (root.items.length == 0) { return accept; }
            if (e.text == Key.UpArrow) { root.index = Math.mod(root.index - 1 + root.items.length, root.items.length); return accept; }
            if (e.text == Key.DownArrow) { root.index = Math.mod(root.index + 1, root.items.length); return accept; }
            if (e.text == Key.Return) { root.activate(root.index); return accept; }
            return accept;
        }
    }
}
