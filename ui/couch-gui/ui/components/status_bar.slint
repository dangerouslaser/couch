import { Theme } from "../theme.slint";

// Fixed, present on every screen. The centre title is the only thing that
// changes between screens, so it is a single property on the shell.
export component StatusBar inherits Rectangle {
    in property <string> clock;
    in property <string> title;
    in property <int> battery;      // 0-100
    in property <bool> charging;

    height: 56px;
    background: Theme.bg;

    // 1px bottom rule
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-dim;
    }

    Text {
        x: Theme.pad-side;
        y: (parent.height - self.height) / 2;
        text: root.clock;
        font-size: 19px;
        color: Theme.text;
    }

    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.title;
        font-size: 16px;
        letter-spacing: 0.12 * 16px;
        color: Theme.accent;
    }

    // Positioned rather than laid out: a HorizontalLayout given an explicit x/y
    // inside a Rectangle does not size itself here, and the cluster is only two
    // items anyway.
    battery-shell := Rectangle {
        width: 32px;
        height: 15px;
        x: parent.width - self.width - Theme.pad-side;
        y: (parent.height - self.height) / 2;
        border-width: 1.5px;
        border-color: Theme.text-secondary;
        border-radius: 3px;

        // Inset 2px with a 9px right gap at full charge, so the fill length
        // reads as the level.
        Rectangle {
            x: 2px;
            y: 2px;
            height: parent.height - 4px;
            width: (parent.width - 4px - 9px) * max(0, min(100, root.battery)) / 100;
            background: Theme.text-secondary;
            border-radius: 1px;
        }
    }

    Text {
        text: root.charging ? "CHG" : "HUB";
        font-size: 15px;
        color: Theme.text-secondary;
        x: battery-shell.x - self.width - 8px;
        y: (parent.height - self.height) / 2;
    }
}
