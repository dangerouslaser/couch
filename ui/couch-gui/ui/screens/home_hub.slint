import { Theme } from "../theme.slint";
import { FocusRing } from "../components/focus_ring.slint";
import { SectionLabel } from "../components/section_label.slint";

export struct LiveActivity {
    kind: int,          // 0 sonos (bars), 1 kodi (play triangle)
    title: string,
    // Subtitle halves, joined with a literal separator below: glyphs are
    // embedded at compile time from strings that appear in .slint, so a
    // separator living only in a runtime string is never embedded.
    source: string,     // SONOS
    place: string,      // KITCHEN
}

export struct RoomRow {
    name: string,
    devices: string,    // "5 devices"
    detail: string,     // "Kodi, Hue, LG C3" - may be empty

    active-count: int,
    idle: bool,
    offline: bool,
    dimmed: bool,       // Study in the reference: idle and recessed further
    glyph: int,         // 0 square, 1 rounded-top rect, 2 circle, 3 diamond
}

export struct SceneCell {
    name: string,
    active: bool,
}

// Room icons are Lucide, rasterised to alpha masks by tools/mkuiicons.sh and
// tinted at runtime so the colour still comes from the theme.
//
// lucide-slint would draw these as real vector paths and was tried: it works,
// but it costs 186KB, about 10% more per frame, and two direct dependencies
// that exist only to switch on a feature flag. The design is authored so that
// every glyph is a rectangle, a circle or a triangle, so the vector capability
// had nothing else to pay for itself with. See docs/slint-notes.md.
component RoomIcon inherits Rectangle {
    in property <int> shape;
    in property <color> ink;
    width: 24px;
    height: 24px;

    if root.shape == 0: Image { source: @image-url("../../assets/icon-sofa.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 1: Image { source: @image-url("../../assets/icon-bed.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 2: Image { source: @image-url("../../assets/icon-cooking-pot.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 3: Image { source: @image-url("../../assets/icon-book-open.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 4: Image { source: @image-url("../../assets/icon-door-open.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 5: Image { source: @image-url("../../assets/icon-car.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 6: Image { source: @image-url("../../assets/icon-trees.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 7: Image { source: @image-url("../../assets/icon-lamp.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape == 8: Image { source: @image-url("../../assets/icon-tv.png");
        width: 100%; height: 100%; colorize: root.ink; }
    if root.shape >= 9: Image { source: @image-url("../../assets/icon-house.png");
        width: 100%; height: 100%; colorize: root.ink; }
}

component AreaPane inherits Rectangle {
    in property <[LiveActivity]> activities;
    in property <[RoomRow]> rooms;
    in property <[SceneCell]> scenes;
    // Row 0 is the activity strip when there is one; rooms follow; the scenes
    // row is last. The column only means anything on the horizontal rows.
    in property <int> focus-row;
    in property <int> focus-col;
    in property <int> first-room-row;
    in property <int> scenes-row;

    // The area list scrolls rather than paginating. Everything else on the hub
    // stays put, so the strip, the labels and the scenes never move - only the
    // rows travel under a fixed window.
    property <length> row-pitch: 101px;      // 90px row + 11px gap
    property <length> ring-bleed: 6px;       // ring offset + width
    property <length> rows-h: max(90px,
        Math.floor((roomsbox.height - 2 * root.ring-bleed + 11px) / root.row-pitch)
        * root.row-pitch - 11px);

    // Horizontal rows show two cells and scroll for the rest, so a third
    // activity is reachable rather than squashing the first two.
    property <length> cell-w: (root.width - 2 * Theme.pad-side - 10px) / 2;
    in-out property <length> act-scroll: 0px;
    in-out property <length> scene-scroll: 0px;
    property <length> act-max: max(0px, root.activities.length * (root.cell-w + 10px)
                                        - 10px - (root.width - 2 * Theme.pad-side));
    property <length> scene-max: max(0px, root.scenes.length * (root.cell-w + 10px)
                                          - 10px - (root.width - 2 * Theme.pad-side));

    in-out property <bool> anim-scroll: true;
    animate act-scroll, scene-scroll {
        duration: root.anim-scroll ? 160ms : 0ms;
        easing: ease-out;
    }

    public function ensure-col-visible() {
        root.anim-scroll = true;
        if (root.focus-row < root.first-room-row && root.activities.length > 0) {
            root.act-scroll = min(root.act-max,
                max(0px, (root.focus-col - 1) * (root.cell-w + 10px)));
        } else if (root.focus-row == root.scenes-row && root.scenes.length > 0) {
            root.scene-scroll = min(root.scene-max,
                max(0px, (root.focus-col - 1) * (root.cell-w + 10px)));
        }
    }
    in-out property <length> scroll: 0px;
    property <length> max-scroll: max(0px, root.rooms.length * root.row-pitch
                                           - 11px - root.rows-h);
    // The row list is a single vertical stop per room, so no column applies.

    // Minimal scrolling: move only far enough to bring the focused row fully
    // into the window, and not at all while it is already there. Recomputing
    // from the index alone would scroll on moves that did not need it.
    animate scroll {
        duration: root.anim-scroll ? 160ms : 0ms;
        easing: ease-out;
    }

    public function ensure-visible() {
        root.anim-scroll = true;
        if (root.focus-row < root.first-room-row) { return; }
        if (root.focus-row >= root.scenes-row) { return; }
        self.row-into-view((root.focus-row - root.first-room-row) * root.row-pitch);
    }
    function row-into-view(row-y: length) {
        if (row-y < root.scroll) {
            root.scroll = row-y;
        } else if (row-y + 90px > root.scroll + root.rows-h) {
            root.scroll = min(root.max-scroll, row-y + 90px - root.rows-h);
        }
    }

    // Stops are a single linear ring in reading order: activities, then areas,
    // then scenes. Declared here so the shell can wrap without knowing layout.

    background: Theme.bg;

    VerticalLayout {
        padding-left: Theme.pad-side - root.ring-bleed;
        padding-right: Theme.pad-side - root.ring-bleed;
        spacing: 14px;

        // --- live activities: scrolls horizontally, hidden when the area has
        // nothing playing so the rooms move up ------------------------------
        if root.activities.length > 0: VerticalLayout {
          spacing: 6px;
          Rectangle {
            height: 66px + 2 * root.ring-bleed;
            clip: true;
            Rectangle {
                x: -root.act-scroll;
                y: 0px;
                width: root.activities.length * (root.cell-w + 10px) - 10px
                       + 2 * root.ring-bleed;
                HorizontalLayout {
                    y: root.ring-bleed;
                    height: 66px;
                    spacing: 10px;
                    padding-left: root.ring-bleed;
                    padding-right: root.ring-bleed;
                    for act[i] in root.activities: Rectangle {
                        width: root.cell-w;
                        background: Theme.surface-raised;
                        border-width: 1px;
                        border-color: Theme.border-raised;
                        border-radius: Theme.r-card;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                if act.kind == 0: HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    Rectangle { width: 4px; height: 12px; background: Theme.accent;
                                                y: parent.height - self.height; }
                                    Rectangle { width: 4px; height: 20px; background: Theme.accent;
                                                y: parent.height - self.height; }
                                    Rectangle { width: 4px; height: 8px;  background: Theme.accent;
                                                y: parent.height - self.height; }
                                }
                                if act.kind == 1: Image {
                                    source: @image-url("../../assets/glyph-play.png");
                                    width: 14px; height: 18px;
                                    colorize: Theme.accent;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: act.title;
                                    font-size: 19px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: act.source + " · " + act.place;
                                    font-size: 14px;
                                    letter-spacing: 0.06 * 14px;
                                    color: Theme.text-tertiary;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    x: root.ring-bleed + root.focus-col * (root.cell-w + 10px);
                    y: root.ring-bleed;
                    width: root.cell-w;
                    height: 66px;
                    background: transparent;
                    animate x { duration: 160ms; easing: ease-out; }
                    FocusRing {
                        focused: root.focus-row < root.first-room-row;
                        box-width: parent.width; box-height: parent.height;
                    }
                }
            }
        }

        // Dots only when there is something past the fold to find.
          if root.activities.length > 2: HorizontalLayout {
            height: 6px;
            spacing: 6px;
            alignment: center;
            for act[i] in root.activities: Rectangle {
                width: 6px; height: 6px;
                border-radius: 3px;
                background: root.focus-row < root.first-room-row && root.focus-col == i
                    ? Theme.accent : Theme.border-raised;
            }
        }
        }

        roomsbox := Rectangle {
          Rectangle {
            y: 0px;
            height: root.rows-h + 2 * root.ring-bleed;
            clip: true;
            Rectangle {
                y: root.ring-bleed - root.scroll;
                height: max(0px, root.rooms.length * root.row-pitch - 11px);
                VerticalLayout {
                    spacing: 11px;
                    padding-left: root.ring-bleed;
                    padding-right: root.ring-bleed;
                    for area[i] in root.rooms: Rectangle {
                height: 90px;
                background: area.idle ? Theme.surface-idle : Theme.surface;
                border-width: 1px;
                border-color: area.idle ? Theme.border-idle : Theme.border;
                border-radius: Theme.r-row;

                HorizontalLayout {
                    padding: 18px;
                    spacing: 16px;

                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: Theme.r-disc;
                        background: area.idle ? Theme.surface-icon-idle : Theme.surface-icon;
                        border-width: 1px;
                        border-color: area.idle ? Theme.border-icon-idle : Theme.border-icon;
                        RoomIcon {
                            shape: area.glyph;
                            ink: area.idle ? Theme.text-quaternary : Theme.accent;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: area.name;
                            font-size: 26px;
                            font-weight: 600;
                            color: area.idle ? Theme.text-secondary : Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: area.detail == "" ? area.devices
                                                    : area.devices + " · " + area.detail;
                            font-size: 19px;
                            color: area.idle ? Theme.text-quaternary : Theme.text-secondary;
                            overflow: elide;
                        }
                    }

                    // Status column. The design calls for a glow behind the dot;
                    // on the software renderer that is a blur we cannot afford,
                    // so the documented substitute is a 1px accent ring.
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 0;
                        if !area.idle && !area.offline: Rectangle {
                            width: 19px; height: 19px;
                            background: transparent;
                            border-radius: 9.5px;
                            border-width: 1px;
                            border-color: Theme.accent.with-alpha(0.4);
                            Rectangle {
                                width: 9px; height: 9px;
                                border-radius: 4.5px;
                                background: Theme.accent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: area.offline ? "OFFLINE"
                                : area.idle ? "IDLE"
                                : (area.active-count + " ON");
                            font-size: 14px;
                            horizontal-alignment: right;
                            color: area.offline ? Theme.text-quaternary
                                : area.idle ? (area.dimmed ? Theme.text-disabled : Theme.text-quaternary)
                                : Theme.accent;
                        }
                    }
                }
            }

            }

            // One ring, moved, rather than one per row switched on and off.
            // Switching is a jump however fast the list scrolls underneath;
            // this is the thing the eye actually follows. It also costs less to
            // draw - N conditional borders become one - which is what paid for
            // the animation.
            //
            // It lives inside the scrolling content, so a focus move that also
            // scrolls does not need the two to be reconciled: the ring travels
            // with the rows and only the row-to-row step is animated here.
            Rectangle {
                x: root.ring-bleed;
                y: (root.focus-row - root.first-room-row) * root.row-pitch;
                width: parent.width - 2 * root.ring-bleed;
                height: 90px;
                background: transparent;
                animate y { duration: 160ms; easing: ease-out; }
                FocusRing {
                    focused: root.focus-row >= root.first-room-row
                             && root.focus-row < root.scenes-row;
                    radius-inner: Theme.r-row;
                    box-width: parent.width; box-height: parent.height;
                }
            }
          }
        }
        }

        SectionLabel { text: "SCENES"; height: 19px; x: root.ring-bleed; }

        VerticalLayout {
          spacing: 6px;
          Rectangle {
            height: 74px + 2 * root.ring-bleed;
            clip: true;
            Rectangle {
                x: -root.scene-scroll;
                y: 0px;
                width: root.scenes.length * (root.cell-w + 10px) - 10px
                       + 2 * root.ring-bleed;
                HorizontalLayout {
                    y: root.ring-bleed;
                    height: 74px;
                    spacing: 10px;
                    padding-left: root.ring-bleed;
                    padding-right: root.ring-bleed;
                    for scene[i] in root.scenes: Rectangle {
                        width: root.cell-w;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.r-card;

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Rectangle {
                                    width: 18px; height: 18px;
                                    border-radius: 9px;
                                    background: scene.active ? Theme.accent : transparent;
                                    border-width: scene.active ? 0px : 2px;
                                    border-color: Theme.text-secondary;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: scene.name;
                                    font-size: 21px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    x: root.ring-bleed + root.focus-col * (root.cell-w + 10px);
                    y: root.ring-bleed;
                    width: root.cell-w;
                    height: 74px;
                    background: transparent;
                    animate x { duration: 160ms; easing: ease-out; }
                    FocusRing {
                        focused: root.focus-row == root.scenes-row;
                        radius-inner: Theme.r-card;
                        box-width: parent.width; box-height: parent.height;
                    }
                }
            }
        }

          if root.scenes.length > 2: HorizontalLayout {
            height: 6px;
            spacing: 6px;
            alignment: center;
            for scene[i] in root.scenes: Rectangle {
                width: 6px; height: 6px;
                border-radius: 3px;
                background: root.focus-row == root.scenes-row && root.focus-col == i
                    ? Theme.accent : Theme.border-raised;
            }
        }
        }
    }
}

export component HomeHub inherits Rectangle {
    in property <[LiveActivity]> activities;
    in property <string> area-name;
    in property <int> area-index;
    in property <int> area-count;
    // A model purely to count dots; Slint has no numeric range loop.
    in property <[bool]> area-dots;

    // Two panes: the one on screen, and the one sliding in. The host fills the
    // back pane before asking for the slide, and adopts it when settled().
    in property <[RoomRow]> rooms;
    in property <[SceneCell]> scenes;
    in property <[LiveActivity]> activities-next;
    in property <[RoomRow]> rooms-next;
    in property <[SceneCell]> scenes-next;

    in property <int> focus-row;
    in property <int> focus-col;
    in property <int> first-room-row;
    in property <int> scenes-row;
    // Whether left and right will change area from where focus currently is.
    in property <bool> area-keys-active;

    property <length> ring-bleed: 6px;
    // Measured off our own height rather than the parent's, which a component
    // root cannot see. The strip is conditional, and so is the gap above it.
    property <length> pane-h: root.height - Theme.pad-top - Theme.pad-bottom
                              - 36px - 14px;

    // A slide rather than a cross-fade, and only over the part that changes.
    // Blending two layers costs roughly twice writing each pixel once, which on
    // this CPU is the difference between comfortable and not; and the pager is
    // the control, so it should not travel with the thing it controls.
    property <bool> jumping: false;
    out property <bool> sliding: false;
    property <bool> from-right: true;
    property <length> strip-x: 0px;
    animate strip-x {
        duration: root.jumping ? 0ms : 180ms;
        easing: ease-out;
    }
    callback settled();

    // The transition is split in two so the incoming page is built before
    // anything moves. Creating the pane and starting the animation in the same
    // frame put the whole cost of instantiating a page - repeater items, text
    // layout, the lot - inside the first animated frame, which is exactly where
    // it is most visible as a stutter.
    public function slide(dir: int) {
        root.from-right = dir > 0;
        root.sliding = true;
        prep-timer.running = true;
    }

    prep-timer := Timer {
        interval: 16ms;
        running: false;
        triggered() => {
            self.running = false;
            root.jumping = true;
            root.strip-x = 0px;
            root.jumping = false;
            root.strip-x = root.from-right ? -root.width : root.width;
            settle-timer.running = true;
        }
    }

    settle-timer := Timer {
        interval: 180ms;
        running: false;
        triggered() => {
            self.running = false;
            // Adopt the incoming pane as the resident one and jump back, which
            // is invisible because the host has just swapped the content.
            root.settled();
            root.jumping = true;
            root.strip-x = 0px;
            root.jumping = false;
            root.sliding = false;
        }
    }

    public function ensure-visible() {
        front.ensure-visible();
        front.ensure-col-visible();
    }
    public function ensure-col-visible() { front.ensure-col-visible(); }
    public function reset-scroll() {
        front.anim-scroll = false;
        front.scroll = 0px;
        front.act-scroll = 0px;
        front.scene-scroll = 0px;
    }

    background: Theme.bg;

    VerticalLayout {
        padding-top: Theme.pad-top;
        padding-bottom: Theme.pad-bottom;
        spacing: 14px;

        // Left and right move between areas, up and down between rooms. The
        // chevrons and dots are the only thing telling a user the sideways axis
        // exists, so they are not decoration.
        VerticalLayout {
            height: 36px;
            spacing: 4px;

            HorizontalLayout {
                height: 26px;
                padding-left: Theme.pad-side;
                padding-right: Theme.pad-side;
                Image {
                    source: @image-url("../../assets/chevron-left.png");
                    width: 18px; height: 18px;
                    colorize: root.area-count > 1 && root.area-keys-active
                        ? Theme.text-secondary : Theme.text-disabled;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.area-name;
                    font-size: 16px;
                    letter-spacing: 0.12 * 16px;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Image {
                    source: @image-url("../../assets/chevron-right.png");
                    width: 18px; height: 18px;
                    colorize: root.area-count > 1 && root.area-keys-active
                        ? Theme.text-secondary : Theme.text-disabled;
                    y: (parent.height - self.height) / 2;
                }
            }

            HorizontalLayout {
                height: 6px;
                spacing: 6px;
                alignment: center;
                for dot[i] in root.area-dots: Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px;
                    background: i == root.area-index ? Theme.accent : Theme.border-raised;
                }
            }
        }

        // The sliding window. Only this part moves.
        Rectangle {
            clip: true;
            Rectangle {
                x: root.strip-x;
                front := AreaPane {
                    x: 0px;
                    width: root.width;
                    height: root.pane-h;
                    activities: root.activities;
                    rooms: root.rooms;
                    scenes: root.scenes;
                    focus-row: root.focus-row;
                    focus-col: root.focus-col;
                    first-room-row: root.first-room-row;
                    scenes-row: root.scenes-row;
                }
                if root.sliding: AreaPane {
                    x: root.from-right ? root.width : -root.width;
                    width: root.width;
                    height: root.pane-h;
                    activities: root.activities-next;
                    rooms: root.rooms-next;
                    scenes: root.scenes-next;
                    focus-row: -1;
                    focus-col: -1;
                    first-room-row: root.first-room-row;
                    scenes-row: root.scenes-row;
                }
            }
        }
    }
}
