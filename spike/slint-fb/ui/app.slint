// A deliberate like-for-like copy of couch-gui's room screen, so the spike
// measures the same work: same tokens, same row height, same focus treatment.
struct Row { title: string, value: string }

component Page inherits Rectangle {
    in property <string> heading;
    in property <int> sel;
    in property <string> clock: "";
    in property <string> battery: "";

    width: 480px;
    height: 800px;
    background: #09090b;                    // C_BACKGROUND

    property <[Row]> rows: [
        { title: "Watch TV",     value: "" },
        { title: "All Lights",   value: "off" },
        { title: "Ceiling Only", value: "off" },
        { title: "Roller Blind", value: "open" },
    ];

    Text {
        x: 16px; y: 16px;
        text: root.heading;
        font-size: 28px;
        color: #fafafa;                     // C_FOREGROUND
    }
    Text {
        x: 300px; y: 24px; width: 164px;
        horizontal-alignment: right;
        text: root.battery + "  " + root.clock;
        font-size: 20px;
        color: #a1a1aa;                     // C_MUTED_FOREGROUND
    }

    // ONE moving highlight, drawn behind everything, rather than a selected
    // state toggled on each row. Slint's DirtyRegion holds at most three
    // rectangles (MAX_COUNT = 3) and merges the rest into whichever grows
    // least, so a change touching six elements collapsed into three bands
    // covering 80% of the screen. A single element that moves dirties exactly
    // two boxes: where it was, and where it now is.
    Rectangle {
        x: root.sel < 4 ? 16px : (root.sel == 4 ? 12px : 244px);
        y: root.sel < 4 ? 88px + root.sel * 68px : 716px;
        width: root.sel < 4 ? 448px : 224px;
        height: root.sel < 4 ? 60px : 68px;
        border-radius: root.sel < 4 ? 12px : 15px;
        background: root.sel < 4 ? #27272a : transparent;    // C_MUTED
        border-width: 3px;                                   // constant: a
        border-color: #d4d4d8;                               // width change is
    }                                                        // a geometry change

    for row[i] in root.rows: Rectangle {
        x: 16px;
        y: 88px + i * 68px;
        width: 448px;
        height: 60px;
        background: transparent;

        Text {
            x: 20px; height: parent.height;
            vertical-alignment: center;
            text: row.title;
            font-size: 20px;
            color: #fafafa;
        }
        Text {
            x: parent.width - 100px; width: 80px; height: parent.height;
            horizontal-alignment: right;
            vertical-alignment: center;
            text: row.value;
            font-size: 14px;
            color: #a1a1aa;
        }
    }

    // A Rectangle's border draws inside the shape, so on the white primary
    // button the ring vanished against its own fill - the trap the C version
    // hit too, solved there with an outline outside the shape.
    Rectangle {
        x: 16px; y: 720px; width: 216px; height: 60px;
        border-radius: 12px;
        background: #fafafa;                                 // C_PRIMARY
        Text {
            text: "All Off"; font-size: 20px; color: #18181b;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    Rectangle {
        x: 248px; y: 720px; width: 216px; height: 60px;
        border-radius: 12px;
        background: transparent;
        border-width: 1px;
        border-color: #27272a;                               // C_BORDER
        Text {
            text: "Scenes"; font-size: 20px; color: #fafafa;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}


// A media "now playing" scene: full-bleed fanart crossfading behind a scrim,
// a clearlogo composited with real alpha, metadata and a transport bar. This
// is the workload that actually exercises image scaling and alpha blending,
// as opposed to moving a focus ring over flat fills.
component MediaScene inherits Rectangle {
    in property <int> sel;
    in property <float> fade;
    in property <float> progress;

    width: 480px;
    height: 800px;
    background: #000000;

    Image {
        x: 0px; y: 0px; width: 480px; height: 800px;
        source: @image-url("../../../assets/fanart_a.png");
        image-fit: cover;
    }
    Image {
        x: 0px; y: 0px; width: 480px; height: 800px;
        source: @image-url("../../../assets/fanart_b.png");
        image-fit: cover;
        opacity: root.fade;
    }

    // Scrim, so the text below stays legible over any frame of the fanart.
    Rectangle {
        x: 0px; y: 360px; width: 480px; height: 440px;
        background: @linear-gradient(180deg, #00000000 0%, #000000cc 45%, #000000f2 100%);
    }

    Image {
        x: 60px; y: 430px; width: 360px; height: 130px;
        source: @image-url("../../../assets/clearlogo.png");
    }

    Text {
        x: 24px; y: 578px; width: 432px;
        text: "The Long Way Home";
        font-size: 24px;
        color: #fafafa;
    }
    Text {
        x: 24px; y: 612px; width: 432px;
        text: "2024  ·  Drama  ·  1h 48m  ·  4K HDR";
        font-size: 14px;
        color: #a1a1aa;
    }

    // Progress bar: the fill moves every frame, so it is never a static scene.
    Rectangle {
        x: 24px; y: 654px; width: 432px; height: 6px;
        border-radius: 3px;
        background: #ffffff33;
    }
    Rectangle {
        x: 24px; y: 654px; width: 432px * root.progress; height: 6px;
        border-radius: 3px;
        background: #fafafa;
    }
    Text {
        x: 24px; y: 668px; width: 100px;
        text: "0:42:17";
        font-size: 14px;
        color: #a1a1aa;
    }
    Text {
        x: 356px; y: 668px; width: 100px;
        horizontal-alignment: right;
        text: "1:48:00";
        font-size: 14px;
        color: #a1a1aa;
    }

    // One moving highlight again, for the same reason as the room screen.
    Rectangle {
        x: 60px + root.sel * 124px;
        y: 706px;
        width: 108px;
        height: 64px;
        border-radius: 14px;
        background: #ffffff1f;
        border-width: 3px;
        border-color: #d4d4d8;
    }
    for label[i] in ["<<", "> ||", ">>"]: Text {
        x: 60px + i * 124px;
        y: 706px;
        width: 108px;
        height: 64px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: label;
        font-size: 22px;
        color: #fafafa;
    }
}

export component App inherits Window {
    width: 480px;
    height: 800px;
    background: #09090b;

    in-out property <int> sel: 0;
    in-out property <string> clock: "--:--";
    in-out property <string> battery: "";

    // Stress mode: two full pages on a track that slides the whole screen, so
    // every frame is a full-screen redraw rather than one dirty row.
    in-out property <bool> stress: false;
    in-out property <bool> media: false;
    in-out property <float> fade: 0.0;
    in-out property <float> progress: 0.0;
    animate fade { duration: 1200ms; easing: ease-in-out; }
    in-out property <length> off: 0px;
    animate off { duration: 400ms; easing: ease-in-out; }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow)   { root.sel = max(0, root.sel - 1); return accept; }
            if (e.text == Key.DownArrow) { root.sel = min(5, root.sel + 1); return accept; }
            return reject;
        }
    }
    init => { fs.focus(); }

    if root.media: MediaScene {
        x: 0px; y: 0px;
        sel: min(2, root.sel);
        fade: root.fade;
        progress: root.progress;
    }

    if !root.stress && !root.media: Page {
        x: 0px; y: 0px;
        heading: "Living Room";
        sel: root.sel;
        clock: root.clock;
        battery: root.battery;
    }

    if root.stress && !root.media: Rectangle {
        x: root.off; y: 0px; width: 960px; height: 800px;
        Page { x: 0px;   heading: "Living Room"; sel: root.sel; clock: root.clock; battery: root.battery; }
        Page { x: 480px; heading: "Kitchen";     sel: 2;        clock: root.clock; battery: root.battery; }
    }
}
