#!/bin/busybox sh
# Couch recovery - a small system whose only job is to hand back a way in when
# the slot under test does not boot.
#
# Why this exists: bringing up a kernel means flashing images that hang, and a
# hang means the watchdog resets the board into the same bad image forever. The
# only way out was MTK download mode, which needs someone to physically power
# cycle the device between every attempt. So the image under test arms the BCB
# on each boot and clears it only once it has proven itself; a boot that hangs
# never clears it, and lk lands here instead of looping.
#
# The kernel is the stock one, which is known to boot. This image deliberately
# does NOT clear the BCB - leaving the flag set is what makes a failed
# experiment come back here. Whoever launches a test clears it as part of
# launching, so only a boot someone actually asked for leaves recovery.
BB=/bin/busybox
AUSB=/sys/class/android_usb/android0
LOG=/dev/mmcblk0p13
A=/mnt/alpine

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t tmpfs tmpfs /tmp
$BB --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Say where we are, and hold the backlight on: a device sitting in recovery
# should not look like a dead one.
( $BB echo ""; $BB echo "   COUCH RECOVERY"; $BB echo ""
  $BB echo "   shell on usb serial"; $BB echo "   boot slot: mmcblk0p8"
  while true; do $BB sleep 3600; done ) | /extra/fbcon -v /dev/fb0 &
( while true; do
      $BB echo 255 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null
      $BB sleep 5
  done ) &

# The USB serial shell comes up first and unconditionally: it is the fallback
# that has to exist even if everything below fails.
$BB echo 1 > /sys/devices/platform/mt_usb/cmode 2>/dev/null
$BB echo 0 > $AUSB/enable 2>/dev/null
$BB echo 1 > $AUSB/f_acm/instances 2>/dev/null
$BB echo 0e8d > $AUSB/idVendor 2>/dev/null
$BB echo 201c > $AUSB/idProduct 2>/dev/null
$BB echo acm > $AUSB/functions 2>/dev/null
$BB echo 1 > $AUSB/enable 2>/dev/null
( while true; do $BB sh </dev/ttyGS0 >/dev/ttyGS0 2>&1; $BB sleep 1; done ) &

# Markers of our own, clear of init's block (13000-13005) and stage2's (13006+).
$BB echo "R0 recovery up" | $BB dd of=$LOG bs=512 seek=13020 count=1 conv=notrunc 2>/dev/null

# Bring up the network so images can be pushed at wire speed rather than
# base64'd through the console. stage2 already knows how to do every part of
# this - vendor blobs, wmt modules, wifi, dhcp, sshd - so run that rather than
# keeping a second copy that would drift out of step. The bind mounts are what
# it expects a first stage to have done: without /dev inside the chroot,
# wpa_supplicant cannot open /dev/urandom and never completes a handshake, and
# udhcpc run outside it takes a lease and silently never applies it.
$BB mkdir -p $A
if $BB mount -t ext4 /dev/mmcblk0p23 $A 2>/dev/null && [ -f $A/opt/couch/stage2.sh ]; then
    $BB mkdir -p $A/proc $A/sys $A/dev $A/tmp
    $BB mount -t proc proc $A/proc 2>/dev/null
    $BB mount -t sysfs sysfs $A/sys 2>/dev/null
    $BB mount -o bind /dev $A/dev 2>/dev/null
    $BB mount -o bind /tmp $A/tmp 2>/dev/null
    ( COUCH_NO_UI=1 $BB sh $A/opt/couch/stage2.sh > /tmp/net.log 2>&1
      IP=$($BB ifconfig wlan0 2>/dev/null | $BB sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
      $BB echo "R1 net ip=${IP:-none}" | $BB dd of=$LOG bs=512 seek=13021 count=1 conv=notrunc 2>/dev/null
    ) &
else
    $BB echo "R1 no rootfs on p23" | $BB dd of=$LOG bs=512 seek=13021 count=1 conv=notrunc 2>/dev/null
fi

while true; do $BB sleep 3600; done
